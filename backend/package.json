{
  "name": "@dealership/backend",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run --no-file-parallelism",
    "migrate": "npm run build --silent && node dist/migrate.js",
    "db:seed:vehicles": "tsx src/scripts/seed-vehicles.ts",
    "db:seed:demo": "tsx src/scripts/seed-demo-vehicles.ts",
    "db:seed:images": "tsx src/scripts/seed-images.ts",
    "db:seed:cached-images": "tsx src/scripts/seed-cached-images.ts",
    "db:seed": "npm run db:seed:vehicles && npm run db:seed:cached-images",
    "db:create-admin": "tsx src/scripts/create-admin.ts",
    "db:check-account": "tsx src/scripts/check-carimage-account.ts",
    "db:audit-images": "tsx src/scripts/audit-images.ts",
    "db:test-resolve": "tsx src/scripts/test-resolve-missing.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^5.0.5"
  }
}
