# Application server port
PORT=3000

# PostgreSQL Docker container configuration
POSTGRES_USER=dealership_app
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=dealership_inventory
POSTGRES_PORT=5433

# PostgreSQL connection string for the local application (connecting to Docker on port 5433)
# Standard format: postgresql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://dealership_app:your_password_here@localhost:5433/dealership_inventory

# Optional individual PostgreSQL connection parameters:
# PGHOST=localhost
# PGPORT=5433
# PGUSER=dealership_app
# PGPASSWORD=your_password_here
# PGDATABASE=dealership_inventory
